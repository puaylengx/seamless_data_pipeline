# ค่าเชื่อมต่อ muic_enrollment สำหรับ scripts/load_enrollment_excel_to_db.py
# คัดลอกเป็น enrollment_db.env แล้วกรอกค่าจริง (ไฟล์ .env ถูก gitignore ไว้แล้ว)
#   cp scripts/enrollment_db.env.example scripts/enrollment_db.env
#
# ค่าเหล่านี้ดูได้จาก Airflow UI > Admin > Connections > mssql_enrollment

ENROLL_DB_HOST=your-sql-server-host
ENROLL_DB_PORT=1433
ENROLL_DB_NAME=muic_enrollment
ENROLL_DB_USER=your-user
ENROLL_DB_PASSWORD=your-password

# ใช้เฉพาะตอนรันด้วย pyodbc (ถ้าใช้ pymssql ไม่ต้องสนใจ)
# ENROLL_DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
